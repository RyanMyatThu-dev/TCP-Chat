{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "NEON CHAT: Singapore TLS invitation rooms, stable Elastic IP, restricted SSH, and three-hour auto-stop.",
  "Parameters": {
    "AdminCidr": {
      "Type": "String",
      "Description": "Your computer public IPv4 as a single /32 (not the CloudShell IP).",
      "AllowedPattern": "(?:\\d{1,3}\\.){3}\\d{1,3}/32"
    },
    "ChatCidr": {
      "Type": "String",
      "Default": "",
      "Description": "Chat ingress CIDR. Use 0.0.0.0/0 for public invitation rooms; empty restricts access to AdminCidr.",
      "AllowedPattern": "(?:(?:\\d{1,3}\\.){3}\\d{1,3}/(?:[0-9]|[12][0-9]|3[0-2]))?"
    },
    "KeyPairName": {
      "Type": "AWS::EC2::KeyPair::KeyName",
      "Description": "Existing SSH key pair in Singapore whose private key you possess."
    },
    "UbuntuAmi": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/canonical/ubuntu/server/noble/stable/current/arm64/hvm/ebs-gp3/ami-id"
    },
    "AppRevision": {
      "Type": "String",
      "Default": "34aa95f74b27de6bb2acfed08db3dbb34b1bbdf3",
      "AllowedPattern": "[0-9a-f]{40}",
      "Description": "Reviewed application commit to deploy (not a moving branch)."
    }
  },
  "Conditions": {
    "HasChatCidr": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ChatCidr"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "VPC": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.77.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "neon-chat"
          },
          {
            "Key": "Project",
            "Value": "neon-chat"
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "neon-chat"
          },
          {
            "Key": "Project",
            "Value": "neon-chat"
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "10.77.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "neon-chat-public"
          },
          {
            "Key": "Project",
            "Value": "neon-chat"
          }
        ]
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "neon-chat"
          },
          {
            "Key": "Project",
            "Value": "neon-chat"
          }
        ]
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "SubnetRoute": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "NEON CHAT: admin SSH and explicitly allowed room access",
        "VpcId": {
          "Ref": "VPC"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "AdminCidr"
            },
            "Description": "Administrator only"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 5000,
            "ToPort": 5000,
            "CidrIp": {
              "Fn::If": [
                "HasChatCidr",
                {
                  "Ref": "ChatCidr"
                },
                {
                  "Ref": "AdminCidr"
                }
              ]
            },
            "Description": "TLS room access"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "neon-chat"
          },
          {
            "Key": "Project",
            "Value": "neon-chat"
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Anyone may create or join invitation rooms on TCP 5000; SSH is administrator-only.",
          "must": [
            "Keep SSH restricted to AdminCidr /32.",
            "Public chat ingress is intentional for code-only onboarding."
          ]
        }
      }
    },
    "ChatInstance": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "InternetRoute",
        "SubnetRoute"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "UbuntuAmi"
        },
        "InstanceType": "t4g.small",
        "KeyName": {
          "Ref": "KeyPairName"
        },
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "InstanceInitiatedShutdownBehavior": "stop",
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "Subnet"
            },
            "GroupSet": [
              {
                "Ref": "SecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeSize": 8,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Join": [
              "\n",
              [
                "#!/bin/bash",
                "set -euo pipefail",
                {
                  "Fn::Sub": "export APP_REVISION='${AppRevision}'"
                },
                "export DEBIAN_FRONTEND=noninteractive",
                "apt-get update",
                "apt-get install -y python3 python3-venv git openssl curl",
                "app_dir=/home/ubuntu/TCP-Chat",
                "git clone --no-checkout https://github.com/RyanMyatThu-dev/TCP-Chat.git \"$app_dir\"",
                "git -C \"$app_dir\" checkout --detach \"$APP_REVISION\"",
                "chown -R ubuntu:ubuntu \"$app_dir\"",
                "runuser -u ubuntu -- python3 -m venv \"$app_dir/.venv\"",
                "runuser -u ubuntu -- \"$app_dir/.venv/bin/python\" -m pip install -r \"$app_dir/requirements.txt\"",
                "install -d -m 700 -o ubuntu -g ubuntu \"$app_dir/secrets\" \"$app_dir/certs\"",
                "runuser -u ubuntu -- \"$app_dir/.venv/bin/python\" - <<'PY'",
                "import os",
                "import secrets",
                "path = '/home/ubuntu/TCP-Chat/secrets/room-password'",
                "fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)",
                "with os.fdopen(fd, 'w') as file:",
                "    file.write(secrets.token_urlsafe(24))",
                "PY",
                "",
                "bash \"$app_dir/deploy/install-service.sh\"",
                "",
                "# Powering down this EBS-backed instance stops it, as configured in CloudFormation.",
                "cat > /etc/systemd/system/neon-chat-autostop.service <<'UNIT'",
                "[Unit]",
                "Description=Stop the temporary chat instance to limit runtime costs",
                "[Service]",
                "Type=oneshot",
                "ExecStart=/usr/sbin/shutdown -h now",
                "UNIT",
                "cat > /etc/systemd/system/neon-chat-autostop.timer <<'UNIT'",
                "[Unit]",
                "Description=Stop the chat instance after three hours",
                "[Timer]",
                "OnActiveSec=3h",
                "AccuracySec=1min",
                "Unit=neon-chat-autostop.service",
                "[Install]",
                "WantedBy=timers.target",
                "UNIT",
                "systemctl daemon-reload",
                "systemctl enable --now neon-chat-autostop.timer",
                "systemctl enable --now neon-chat.service",
                ""
              ]
            ]
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "neon-chat"
          },
          {
            "Key": "Project",
            "Value": "neon-chat"
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Single low-cost temporary room service with persistent TLS authority.",
          "must": [
            "Keep encrypted disk and authority across normal restarts.",
            "UserData runs only on first boot; upgrades require install-service.sh."
          ]
        }
      }
    },
    "ServiceAddress": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "GatewayAttachment",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Installed clients need an address stable across EC2 stop/start.",
          "must": [
            "Preserve this address while published clients use it.",
            "IPv4 is billed even when the instance is stopped."
          ]
        }
      },
      "Properties": {
        "Domain": "vpc",
        "InstanceId": {
          "Ref": "ChatInstance"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-service"
            }
          },
          {
            "Key": "Project",
            "Value": "neon-chat"
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "ChatInstance"
      }
    },
    "PublicIp": {
      "Value": {
        "Ref": "ServiceAddress"
      },
      "Description": "Stable service address; IPv4 charges continue while stopped."
    },
    "SecurityGroupId": {
      "Value": {
        "Ref": "SecurityGroup"
      }
    },
    "SshCommand": {
      "Value": {
        "Fn::Sub": "ssh -i /path/to/key.pem ubuntu@${ServiceAddress}"
      }
    },
    "Readiness": {
      "Value": "Stack completion means infrastructure exists. Verify cloud-init status and neon-chat service over SSH."
    }
  },
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  }
}
